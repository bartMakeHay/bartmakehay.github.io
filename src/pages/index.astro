---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../lib/format-date';
import TopicExplorer from '../components/TopicExplorer.astro';
import { SITE_DESCRIPTION } from '../lib/site';

const posts = (await getCollection('posts')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title="bartmakehay">
	<main class="mx-auto max-w-2xl px-4 py-8">
		<p class="text-xs font-semibold tracking-wide text-accent uppercase">Personal blog</p>
		<p class="mt-3 max-w-[60ch] text-sm text-muted">{SITE_DESCRIPTION}</p>
		<div class="mt-8">
			<TopicExplorer />
		</div>
		<p class="mt-10 text-xs font-semibold tracking-wide text-aside uppercase">Posts</p>
		<ul class="mt-4 space-y-6">
			{posts.map((post) => (
				<li>
					<a href={`/posts/${post.id}/`} class="text-base font-semibold text-ink hover:text-accent">
						{post.data.title}
					</a>
					<p class="mt-1 text-sm text-muted">{post.data.description}</p>
					<p class="mt-1 text-xs text-muted">
						<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
					</p>
				</li>
			))}
		</ul>
	</main>
</Layout>
