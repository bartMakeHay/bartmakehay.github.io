---
import Layout from '../layouts/Layout.astro';
---

<Layout title="bartmakehay">
	<header class="mx-auto max-w-2xl border-b border-border px-4 py-6">
		<h1 class="text-lg font-bold">bartmakehay</h1>
	</header>
	<main class="mx-auto max-w-2xl px-4 py-8">
		<p class="text-xs font-semibold tracking-wide text-accent uppercase">Persoonlijke blog</p>
		<p class="mt-3 max-w-[40ch] text-sm text-muted">
			Blog in opbouw — Astro + Tailwind, gedeployed via GitHub Actions naar GitHub Pages.
		</p>
	</main>
</Layout>
