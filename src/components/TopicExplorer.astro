---
/**
 * "What's been on my mind lately" — four ways to browse the topics of one week.
 *
 * Data: src/data/topics.json, generated from the blog vault
 * (90_Meta/scripts/teasers-naar-topics-json.py). Never edited here by hand.
 * At runtime it comes from the JSON island that TeaserDialog ships, so the
 * page carries one copy instead of one per component.
 *
 * Forms: Shuffle (default) · Map · Deck · Lenses, in a fixed carousel.
 * The chosen form is remembered in this browser under `bmh.explorer.view`.
 * Weeks with more than `mapMax` topics drop the Map form; Lenses takes its place.
 * Without JavaScript the latest week renders as a plain list of topics.
 */
import topicsData from '../data/topics.json';
import TeaserDialog from './TeaserDialog.astro';

/* server-side, only for the noscript list; the rest is read from the island */
const { topics, weeks } = topicsData;
const byId = Object.fromEntries(topics.map((t) => [t.id, t]));
const weekKeys = Object.keys(weeks).sort();
const latest = weekKeys[weekKeys.length - 1];
const latestTopics = Object.keys(weeks[latest]).map((id) => byId[id]);
const latestNum = Number(latest.split('-W')[1]);
---

<section class="tx" data-explorer aria-label="What's been on my mind lately">
	<noscript>
		<p class="tx-kicker">What's been on my mind lately</p>
		<p class="tx-nojs">Week {latestNum}, {latestTopics.length} topics.</p>
		<ul class="tx-nojs-list">
			{latestTopics.map((t) => (
				<li><b>{t.title}</b> — {t.hook}</li>
			))}
		</ul>
	</noscript>
</section>

<TeaserDialog />

<script is:inline>
	(function () {
		const root = document.querySelector('[data-explorer]');
		if (!root) return;

		/* the island sits in TeaserDialog, rendered just above this script */
		const { topics, lenses, weeks, mapMax } = JSON.parse(document.getElementById('topics-data').textContent);
		const byId = Object.fromEntries(topics.map((t) => [t.id, t]));
		const WEEK_KEYS = Object.keys(weeks).sort();
		const LATEST = WEEK_KEYS[WEEK_KEYS.length - 1];
		const FORMS = [
			{ id: 'shuffle', label: 'Shuffle' },
			{ id: 'map', label: 'Map' },
			{ id: 'deck', label: 'Deck' },
			{ id: 'lenses', label: 'Lenses' },
		];
		const DEFAULT_FORM = 'shuffle'; /* standaardvorm bij een eerste bezoek en na 'Forget saved view' */
		const DEFAULT_IDX = FORMS.findIndex((f) => f.id === DEFAULT_FORM);
		const KEY = 'bmh.explorer.view';

		const readPref = () => {
			try {
				const v = localStorage.getItem(KEY);
				return FORMS.some((f) => f.id === v) ? v : null;
			} catch (e) {
				return null;
			}
		};
		const writePref = (v) => {
			try {
				v == null ? localStorage.removeItem(KEY) : localStorage.setItem(KEY, v);
			} catch (e) {}
		};

		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const rnd = (arr) => arr[Math.floor(Math.random() * arr.length)];
		const esc = (s) => String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;');
		/* same convention as a blog post (Conventies.md §Haakjestekst): a "(...)" aside
		   renders muted. Tags pass through untouched so a link inside a parenthetical
		   still wraps — this only ever sees tags this file generates itself, never raw "<". */
		const paren = (html) => {
			let out = '', depth = 0, i = 0;
			while (i < html.length) {
				const ch = html[i];
				if (ch === '<') {
					const end = html.indexOf('>', i);
					out += end === -1 ? html.slice(i) : html.slice(i, end + 1);
					i = end === -1 ? html.length : end + 1;
					continue;
				}
				if (ch === '(') { if (depth === 0) out += '<span class="text-aside">'; depth++; }
				out += ch;
				if (ch === ')' && depth > 0) { depth--; if (depth === 0) out += '</span>'; }
				i++;
			}
			return out;
		};
		/* the note text is markdown: internal post links and plain external links */
		const md = (s) =>
			paren(
				esc(s)
					.replace(/\[([^\]]+)\]\(post:([a-z0-9-]+)\)/g, (m, txt, slug) => '<a href="/posts/' + slug + '/">' + txt + '</a>')
					.replace(/\[([^\]]+)\]\((https?:\/\/[^\s)"'<>]+)\)/g, (m, txt, url) => '<a href="' + url + '" target="_blank" rel="noopener noreferrer">' + txt + '</a>')
			);
		const dotsHtml = (w) =>
			'<span class="dots" aria-hidden="true">' + [1, 2, 3].map((i) => '<i class="' + (i <= w ? 'on' : '') + '"></i>').join('') + '</span>';
		const weekNum = (key) => Number(key.split('-W')[1]);
		const timesLabel = (w, key) => (w === 1 ? 'surfaced once' : 'surfaced ' + w + '×') + ' in week ' + weekNum(key);
		const weekTopics = (key) =>
			Object.entries(weeks[key])
				.map(([id, w]) => Object.assign({}, byId[id], { w }))
				.sort((a, b) => b.w - a.w);

		/* ---- ISO week helpers ---- */
		const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
		const pad = (n) => String(n).padStart(2, '0');
		function mondayOf(d) {
			const t = new Date(d.getFullYear(), d.getMonth(), d.getDate());
			t.setDate(t.getDate() - ((t.getDay() + 6) % 7));
			return t;
		}
		function weekKeyOf(d) {
			const t = new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));
			const day = t.getUTCDay() || 7;
			t.setUTCDate(t.getUTCDate() + 4 - day);
			const y = t.getUTCFullYear();
			const w = Math.ceil(((t - Date.UTC(y, 0, 1)) / 86400000 + 1) / 7);
			return y + '-W' + pad(w);
		}
		function mondayFromKey(key) {
			const [y, w] = key.split('-W').map(Number);
			const m = mondayOf(new Date(y, 0, 4));
			m.setDate(m.getDate() + (w - 1) * 7);
			return m;
		}
		function rangeLabel(key) {
			const a = mondayFromKey(key);
			const b = new Date(a);
			b.setDate(a.getDate() + 6);
			return a.getMonth() === b.getMonth()
				? a.getDate() + '–' + b.getDate() + ' ' + MONTHS[a.getMonth()] + ' ' + a.getFullYear()
				: a.getDate() + ' ' + MONTHS[a.getMonth()] + ' – ' + b.getDate() + ' ' + MONTHS[b.getMonth()] + ' ' + b.getFullYear();
		}
		const TODAY = new Date();
		const monthIdx = (y, m) => y * 12 + m;
		const firstMonday = mondayFromKey(WEEK_KEYS[0]);
		const MIN_MONTH = monthIdx(firstMonday.getFullYear(), firstMonday.getMonth());
		const lastMonday = mondayFromKey(LATEST);
		const MAX_MONTH = Math.max(monthIdx(TODAY.getFullYear(), TODAY.getMonth()), monthIdx(lastMonday.getFullYear(), lastMonday.getMonth()));

		const CHEV_L = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>';
		const CHEV_R = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>';
		const CAL = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/></svg>';

		const inst = { root, mode: 'choose', idx: DEFAULT_IDX, week: LATEST, pick: false, cal: null, lens: 'wow' };
		const pref = readPref();
		if (pref) {
			inst.mode = 'saved';
			inst.idx = FORMS.findIndex((f) => f.id === pref);
		}
		function resetWeekState(i) {
			const list = weekTopics(i.week);
			i.topics = list;
			i.shuffle = { history: [], seen: new Set(), cur: list[0].id };
			i.deck = { drawn: [], cur: null };
			if (!list.some((t) => t.lens === i.lens)) i.lens = list[0].lens;
		}

		/* A week with too many topics has no readable map; the carousel skips that form. */
		const mapOff = (i) => i.topics.length > mapMax;
		const available = (i, f) => !(mapOff(i) && f.id === 'map');
		function step(i, dir) {
			let n = i.idx;
			for (let k = 0; k < FORMS.length; k++) {
				n = (n + dir + FORMS.length) % FORMS.length;
				if (available(i, FORMS[n])) return n;
			}
			return i.idx;
		}

		function render(i, toast) {
			const saved = readPref();
			const chosen = FORMS[i.idx];
			const form = available(i, chosen) ? chosen : FORMS.find((f) => f.id === 'lenses');
			const swapped = form !== chosen;
			const off = mapOff(i);

			const kicker = '<p class="tx-kicker">What’s been on my mind lately</p>';

			let tabsRow;
			if (i.mode === 'choose') {
				tabsRow =
					'<div class="tx-nav"><button class="tx-chev" data-act="prev" aria-label="Previous view">' + CHEV_L + '</button>' +
					'<div class="tx-tabs" role="tablist">' +
					FORMS.map((f, n) =>
						available(i, f)
							? '<button class="tx-tab" role="tab" data-act="tab" data-idx="' + n + '" aria-selected="' + (f === form) + '"><i></i>' + f.label + '</button>'
							: '<button class="tx-tab tx-tab--off" role="tab" disabled aria-selected="false" title="Too many topics in week ' + weekNum(i.week) + ' for the map"><i></i>' + f.label + '</button>'
					).join('') +
					'</div><button class="tx-chev" data-act="next" aria-label="Next view">' + CHEV_R + '</button></div>';
			} else {
				tabsRow =
					'<span class="tx-saved">Your view: <b>' + chosen.label + '</b>' +
					(swapped ? ' · <span class="tx-swap">showing ' + form.label + ' this week, the map gets crowded above ' + mapMax + ' topics</span>' : '') +
					' · <button class="tx-link" data-act="change">Change view</button></span>';
			}

			const weekIdx = WEEK_KEYS.indexOf(i.week);
			const bar =
				'<div class="tx-week">' +
				'<button class="tx-chev" data-act="week-prev" aria-label="Previous week"' + (weekIdx <= 0 ? ' disabled' : '') + '>' + CHEV_L + '</button>' +
				'<span><b>Week ' + weekNum(i.week) + '</b> · ' + rangeLabel(i.week) + '</span>' +
				'<button class="tx-chev" data-act="week-next" aria-label="Next week"' + (weekIdx >= WEEK_KEYS.length - 1 ? ' disabled' : '') + '>' + CHEV_R + '</button>' +
				'<span class="sep">|</span><button class="tx-link" data-act="pick" aria-expanded="' + i.pick + '">' + CAL + (i.pick ? 'Close' : 'Other week') + '</button>' +
				(i.week !== LATEST ? '<span class="sep">·</span><button class="tx-link" data-act="latest">Latest</button>' : '') +
				'</div>';

			let foot = '';
			if (i.mode === 'choose') {
				foot =
					'<div class="tx-foot"><span class="grp">' +
					(toast
						? '<span class="tx-toast">' + toast + '</span>'
						: '<span>' + (off ? 'Three ways' : 'Four ways') + ' to browse the same ' + i.topics.length + ' topics' +
						  (off ? ' — the map sits out this week, ' + i.topics.length + ' dots is too many to read' : '') + '. Swipe or use the arrows.</span>') +
					(saved ? ' <button class="tx-link" data-act="forget">Forget saved view</button>' : '') +
					'</span><span class="grp"><span>Saved in this browser only</span>' +
					'<button class="tx-keep" data-act="keep">' + (saved === form.id ? 'Kept ✓' : 'Keep this view') + '</button></span></div>';
			}

			i.root.innerHTML =
				'<div class="tx-toprow">' + kicker + bar + '</div>' +
				(i.pick ? calendar(i) : '') +
				'<div class="tx-formrow">' + tabsRow + '</div>' + foot +
				'<div class="tx-panel" data-form="' + form.id + '"></div>';

			const panel = i.root.querySelector('.tx-panel');
			({ shuffle: renderShuffle, map: renderMap, deck: renderDeck, lenses: renderLenses })[form.id](panel, i);
			if (!reduceMotion) panel.classList.add('pop');
			wire(i, form);
		}

		function wire(i, form) {
			i.root.onclick = (e) => {
				const b = e.target.closest('[data-act]');
				if (!b || !i.root.contains(b)) return;
				const act = b.dataset.act;
				if (act === 'prev') { i.idx = step(i, -1); render(i); }
				else if (act === 'next') { i.idx = step(i, 1); render(i); }
				else if (act === 'tab') { i.idx = Number(b.dataset.idx); render(i); }
				else if (act === 'keep') { writePref(form.id); render(i, 'Kept. Next time this page opens in ' + form.label + '.'); }
				else if (act === 'forget') { writePref(null); render(i, 'Forgotten. The page will open with the carousel again.'); }
				else if (act === 'change') { i.mode = 'choose'; render(i); }
				else if (act === 'pick') {
					i.pick = !i.pick;
					if (i.pick) { const m = mondayFromKey(i.week); i.cal = { y: m.getFullYear(), m: m.getMonth() }; }
					render(i);
				} else if (act === 'latest') { i.week = LATEST; i.pick = false; resetWeekState(i); render(i); }
				else if (act === 'cal-prev') {
					const n = monthIdx(i.cal.y, i.cal.m) - 1;
					if (n >= MIN_MONTH) { i.cal = { y: Math.floor(n / 12), m: n % 12 }; render(i); }
				} else if (act === 'cal-next') {
					const n = monthIdx(i.cal.y, i.cal.m) + 1;
					if (n <= MAX_MONTH) { i.cal = { y: Math.floor(n / 12), m: n % 12 }; render(i); }
				} else if (act === 'cal-latest') {
					const m = mondayFromKey(LATEST);
					i.cal = { y: m.getFullYear(), m: m.getMonth() };
					i.week = LATEST; resetWeekState(i); render(i);
				} else if (act === 'week') {
					i.week = b.dataset.week; i.pick = false; resetWeekState(i);
					if (!available(i, FORMS[i.idx]) && i.mode === 'choose') i.idx = FORMS.findIndex((f) => f.id === 'lenses');
					render(i);
				} else if (act === 'week-prev' || act === 'week-next') {
					const idx = WEEK_KEYS.indexOf(i.week) + (act === 'week-prev' ? -1 : 1);
					if (idx < 0 || idx >= WEEK_KEYS.length) return;
					i.week = WEEK_KEYS[idx]; i.pick = false; resetWeekState(i);
					if (!available(i, FORMS[i.idx]) && i.mode === 'choose') i.idx = FORMS.findIndex((f) => f.id === 'lenses');
					render(i);
				}
			};

			let sx = null;
			const panel = i.root.querySelector('.tx-panel');
			panel.onpointerdown = (e) => { sx = e.clientX; };
			panel.onpointerup = (e) => {
				if (sx == null || i.mode !== 'choose') return;
				const dx = e.clientX - sx;
				sx = null;
				if (Math.abs(dx) > 60) { i.idx = step(i, dx < 0 ? 1 : -1); render(i); }
			};
			i.root.onkeydown = (e) => {
				if (i.mode === 'choose' && e.target.closest('.tx-tabs') && (e.key === 'ArrowLeft' || e.key === 'ArrowRight')) {
					e.preventDefault();
					i.idx = step(i, e.key === 'ArrowRight' ? 1 : -1);
					render(i);
					i.root.querySelector('.tx-tab[aria-selected="true"]').focus();
				}
			};
		}

		/* ---- week picker ---- */
		function calendar(i) {
			const y = i.cal.y, m = i.cal.m;
			const cur = monthIdx(y, m);
			let html =
				'<div class="tx-cal"><div class="cal-head"><b>' + MONTHS[m] + ' ' + y + '</b><div class="cal-nav">' +
				'<button class="cal-btn" data-act="cal-prev" aria-label="Previous month"' + (cur <= MIN_MONTH ? ' disabled' : '') + '>' + CHEV_L + '</button>' +
				'<button class="cal-btn" data-act="cal-latest">Latest</button>' +
				'<button class="cal-btn" data-act="cal-next" aria-label="Next month"' + (cur >= MAX_MONTH ? ' disabled' : '') + '>' + CHEV_R + '</button>' +
				'</div></div><div class="cal-grid"><span class="cal-h">W</span>' +
				['M', 'T', 'W', 'T', 'F', 'S', 'S'].map((d) => '<span class="cal-h">' + d + '</span>').join('');
			const first = mondayOf(new Date(y, m, 1));
			for (let r = 0; r < 6; r++) {
				const monday = new Date(first);
				monday.setDate(first.getDate() + r * 7);
				const key = weekKeyOf(monday);
				const has = !!weeks[key];
				html +=
					'<button class="cal-w' + (has ? ' has' : '') + (key === i.week ? ' is-sel' : '') + '" data-act="' + (has ? 'week' : 'none') + '" data-week="' + key + '"' +
					(has ? ' title="Week ' + weekNum(key) + ': ' + Object.keys(weeks[key]).length + ' topics"' : ' tabindex="-1" aria-disabled="true"') +
					'>' + weekNum(key) + '<span class="dot"></span></button>';
				for (let d = 0; d < 7; d++) {
					const day = new Date(monday);
					day.setDate(monday.getDate() + d);
					html += '<span class="cal-d' + (day.getMonth() === m ? '' : ' out') + '">' + day.getDate() + '</span>';
				}
			}
			return html + '</div><p class="cal-note">A dot marks a week with an overview.</p></div>';
		}

		/* ---- form 1: shuffle ---- */
		function renderShuffle(panel, i) {
			const s = i.shuffle, list = i.topics, n = list.length;
			const draw = () => {
				const t = list.find((x) => x.id === s.cur) || list[0];
				s.cur = t.id;
				s.seen.add(t.id);
				panel.innerHTML =
					'<div class="sh"><button class="sh-arrow" data-sh="go" aria-label="Shuffle to another topic">' + CHEV_L + '</button>' +
					'<button class="sh-card" data-topic="' + t.id + '" data-week="' + i.week + '"><span class="t-eyebrow">' + lenses[t.lens].label + '</span>' +
					'<span class="t-title">' + esc(t.title) + '</span><span class="t-hook">' + md(t.hook) + '</span>' +
					'<span class="t-cta"><span>' + dotsHtml(t.w) + ' ' + timesLabel(t.w, i.week) + '</span><span>Open teaser →</span></span></button>' +
					'<button class="sh-arrow" data-sh="go" aria-label="Shuffle to another topic">' + CHEV_R + '</button></div>' +
					'<div class="sh-seen"><span>Seen ' + s.seen.size + ' of ' + n + '</span><div class="sh-bar"><span style="width:' + (s.seen.size / n) * 100 + '%"></span></div><span>shuffle, don’t scroll</span></div>';
			};
			draw();
			panel.onclick = (e) => {
				if (!e.target.closest('[data-sh]')) return;
				s.history.push(s.cur);
				if (s.history.length > Math.min(3, n - 1)) s.history.shift();
				const pool = list.filter((t) => !s.history.includes(t.id) && t.id !== s.cur);
				s.cur = (pool.length ? rnd(pool) : rnd(list.filter((t) => t.id !== s.cur))).id;
				draw();
				const card = panel.querySelector('.sh-card');
				if (!reduceMotion && card) card.classList.add('pop');
			};
		}

		/* ---- map layout: pluggable, see MAP_LAYOUTS below ----
		 * Contract: fn(nodes, edges, w, h) -> { [nodeId]: {x, y, r} }.
		 * nodes: [{id, w: weight 1-3}], edges: [[idA, idB], ...]. The
		 * layout owns node radius r too, since it may need to shrink dots
		 * to keep everything overlap-free at higher topic counts.
		 * Swapping the algorithm later = add a function here and flip
		 * ACTIVE_MAP_LAYOUT; renderMap never needs to change. */
		function seeded(str) {
			let h = 0;
			for (let i = 0; i < str.length; i++) h = (Math.imul(31, h) + str.charCodeAt(i)) | 0;
			return () => {
				h = (h * 1103515245 + 12345) & 0x7fffffff;
				return h / 0x7fffffff;
			};
		}
		function forceLayout(nodes, edges, W, H) {
			const n = nodes.length;
			const pos = {};
			if (n === 0) return pos;
			const rand = seeded(nodes.map((t) => t.id).join('|'));
			const spread = Math.min(W, H) * 0.32;
			nodes.forEach((t, idx) => {
				const a = (idx / n) * Math.PI * 2 + rand() * 0.6;
				pos[t.id] = { x: W / 2 + Math.cos(a) * spread * (0.3 + rand() * 0.7), y: H / 2 + Math.sin(a) * spread * (0.3 + rand() * 0.7) };
			});
			const rad = Object.fromEntries(nodes.map((t) => [t.id, 13 + t.w * 5]));
			const idealLen = spread;
			const STEPS = 300;
			for (let step = 0; step < STEPS; step++) {
				const cool = 1 - step / STEPS;
				const disp = Object.fromEntries(nodes.map((t) => [t.id, { x: 0, y: 0 }]));
				for (let a = 0; a < n; a++) {
					for (let b = a + 1; b < n; b++) {
						const A = nodes[a], B = nodes[b];
						const dx = pos[A.id].x - pos[B.id].x, dy = pos[A.id].y - pos[B.id].y;
						const d = Math.hypot(dx, dy) || 0.01;
						const min = rad[A.id] + rad[B.id] + 24;
						const rep = (min * min) / d * 0.06;
						const fx = (dx / d) * rep, fy = (dy / d) * rep;
						disp[A.id].x += fx; disp[A.id].y += fy;
						disp[B.id].x -= fx; disp[B.id].y -= fy;
					}
				}
				edges.forEach(([aId, bId]) => {
					const A = pos[aId], B = pos[bId];
					const dx = B.x - A.x, dy = B.y - A.y;
					const d = Math.hypot(dx, dy) || 0.01;
					const f = (d - idealLen) * 0.02;
					const fx = (dx / d) * f, fy = (dy / d) * f;
					disp[aId].x += fx; disp[aId].y += fy;
					disp[bId].x -= fx; disp[bId].y -= fy;
				});
				nodes.forEach((t) => {
					disp[t.id].x += (W / 2 - pos[t.id].x) * 0.01;
					disp[t.id].y += (H / 2 - pos[t.id].y) * 0.01;
				});
				nodes.forEach((t) => {
					pos[t.id].x += disp[t.id].x * cool;
					pos[t.id].y += disp[t.id].y * cool;
				});
			}
			/* resolve remaining overlaps freely (unclamped — pinning to the
			 * canvas mid-resolution is what caused corner-case stuck overlaps) */
			for (let pass = 0; pass < 500; pass++) {
				let moved = false;
				for (let a = 0; a < n; a++) {
					for (let b = a + 1; b < n; b++) {
						const A = nodes[a], B = nodes[b];
						const dx = pos[A.id].x - pos[B.id].x, dy = pos[A.id].y - pos[B.id].y;
						const d = Math.hypot(dx, dy) || 0.01;
						const min = rad[A.id] + rad[B.id] + 20;
						if (d < min) {
							moved = true;
							const push = (min - d) / 2, ux = dx / d, uy = dy / d;
							pos[A.id].x += ux * push; pos[A.id].y += uy * push;
							pos[B.id].x -= ux * push; pos[B.id].y -= uy * push;
						}
					}
				}
				if (!moved) break;
			}
			/* scale the whole layout (positions AND radii) to fit the canvas —
			 * shrinking node size along with spacing is what keeps busier
			 * weeks overlap-free instead of just clamping dots into the wall */
			let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
			nodes.forEach((t) => {
				const r = rad[t.id];
				minX = Math.min(minX, pos[t.id].x - r); maxX = Math.max(maxX, pos[t.id].x + r);
				minY = Math.min(minY, pos[t.id].y - r); maxY = Math.max(maxY, pos[t.id].y + r);
			});
			const pad = 26;
			const availW = W - pad * 2, availH = H - pad * 2 - 20; // extra room below for labels
			const spanX = maxX - minX || 1, spanY = maxY - minY || 1;
			const scale = Math.min(1, availW / spanX, availH / spanY);
			const cx = (minX + maxX) / 2, cy = (minY + maxY) / 2;
			const out = {};
			nodes.forEach((t) => {
				out[t.id] = {
					x: W / 2 + (pos[t.id].x - cx) * scale,
					y: H / 2 + (pos[t.id].y - cy) * scale,
					r: rad[t.id] * scale,
				};
			});
			return out;
		}
		const MAP_LAYOUTS = { force: forceLayout };
		const ACTIVE_MAP_LAYOUT = 'force';
		const computeMapLayout = (nodes, edges, w, h) => MAP_LAYOUTS[ACTIVE_MAP_LAYOUT](nodes, edges, w, h);

		/* ---- form 2: map ---- */
		function renderMap(panel, i) {
			const NS = 'http://www.w3.org/2000/svg';
			const list = i.topics;
			const present = new Set(list.map((t) => t.id));
			const W = 660, H = 540;
			panel.innerHTML =
				'<svg class="sky" viewBox="0 0 ' + W + ' ' + H + '" role="group" aria-label="Topic map"></svg>' +
				'<p class="sky-hint">Bigger dots surfaced more often in week ' + weekNum(i.week) + '. Each topic is linked to the three topics it has most often shown up alongside, across all weeks. Hover for neighbours, click to read.</p>';
			const svg = panel.querySelector('svg');
			const edgeList = [], doneE = new Set();
			list.forEach((t) =>
				(t.related || []).forEach((r) => {
					if (!present.has(r)) return;
					const key = [t.id, r].sort().join('|');
					if (doneE.has(key)) return;
					doneE.add(key);
					edgeList.push([t.id, r]);
				})
			);
			const pos = computeMapLayout(list, edgeList, W, H);
			const edges = [], nodes = {};
			edgeList.forEach(([aId, bId]) => {
				const l = document.createElementNS(NS, 'line');
				l.setAttribute('x1', pos[aId].x); l.setAttribute('y1', pos[aId].y);
				l.setAttribute('x2', pos[bId].x); l.setAttribute('y2', pos[bId].y);
				l.setAttribute('class', 'edge');
				l.dataset.a = aId; l.dataset.b = bId;
				svg.appendChild(l); edges.push(l);
			});
			list.forEach((t) => {
				const { x, y: cy, r } = pos[t.id];
				const g = document.createElementNS(NS, 'g');
				g.setAttribute('class', 'node');
				g.setAttribute('tabindex', '0');
				g.setAttribute('role', 'button');
				g.setAttribute('aria-label', t.title);
				const c = document.createElementNS(NS, 'circle');
				c.setAttribute('cx', x); c.setAttribute('cy', cy); c.setAttribute('r', r);
				const ring = document.createElementNS(NS, 'circle');
				ring.setAttribute('cx', x); ring.setAttribute('cy', cy); ring.setAttribute('r', r + 5); ring.setAttribute('class', 'ring');
				const tx = document.createElementNS(NS, 'text');
				tx.setAttribute('x', x); tx.setAttribute('y', cy + r + 14);
				tx.textContent = t.title;
				g.appendChild(c); g.appendChild(ring); g.appendChild(tx);
				svg.appendChild(g);
				nodes[t.id] = g;
				const on = () => {
					svg.classList.add('has-focus');
					g.classList.add('is-active');
					(t.related || []).forEach((id) => nodes[id] && nodes[id].classList.add('is-near'));
					edges.forEach((l) => { if (l.dataset.a === t.id || l.dataset.b === t.id) l.classList.add('is-lit'); });
				};
				const off = () => {
					svg.classList.remove('has-focus');
					g.classList.remove('is-active');
					Object.values(nodes).forEach((n) => n.classList.remove('is-near'));
					edges.forEach((l) => l.classList.remove('is-lit'));
				};
				g.addEventListener('mouseenter', on); g.addEventListener('mouseleave', off);
				g.addEventListener('focus', on); g.addEventListener('blur', off);
				g.addEventListener('keydown', (e) => {
					if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); g.dispatchEvent(new MouseEvent('click', { bubbles: true })); }
				});
				g.dataset.topic = t.id;
				g.dataset.week = i.week;
			});
		}

		/* ---- form 3: deck ---- */
		function renderDeck(panel, i) {
			const d = i.deck, list = i.topics;
			panel.innerHTML =
				'<div class="dk"><div class="deck"><div class="sc s1"></div><div class="sc s2"></div>' +
				'<button class="flip' + (d.cur ? ' is-flipped' : '') + '" data-dk="flip" aria-label="Draw a card">' +
				'<div class="face face--back"><div class="b-mark">?</div><div class="b-title">Draw a card</div><div class="b-sub">' + list.length + ' topics from week ' + weekNum(i.week) + '</div></div>' +
				'<div class="face face--front"></div></button></div>' +
				'<div class="dk-side"><div class="dk-actions"><button class="tx-btn tx-btn--primary" data-dk="draw">' + (d.cur ? 'Draw another' : 'Draw a card') + '</button>' +
				'<button class="tx-btn" data-dk="read"' + (d.cur ? '' : ' hidden') + '>Read the teaser</button></div>' +
				'<div><p class="collected-label">Drawn so far</p><div class="collected"></div></div></div></div>';
			const flip = panel.querySelector('.flip');
			const front = panel.querySelector('.face--front');
			const drawBtn = panel.querySelector('[data-dk="draw"]');
			const readBtn = panel.querySelector('[data-dk="read"]');
			const coll = panel.querySelector('.collected');
			const paint = () => {
				if (d.cur) {
					const t = byId[d.cur];
					front.innerHTML =
						'<span class="t-eyebrow">' + lenses[t.lens].label + '</span><span class="t-title">' + esc(t.title) + '</span>' +
						'<span class="t-hook">' + md(t.hook) + '</span><span class="t-cta">Read the teaser →</span>';
				}
				coll.innerHTML = d.drawn.map((id) => '<button class="mini" data-topic="' + id + '" data-week="' + i.week + '">' + esc(byId[id].title) + '</button>').join('');
			};
			const draw = () => {
				const remaining = list.filter((t) => !d.drawn.includes(t.id));
				const next = remaining.length ? rnd(remaining) : rnd(list.filter((t) => t.id !== d.cur).concat(list.length === 1 ? list : []));
				const apply = () => {
					d.cur = next.id;
					if (!d.drawn.includes(next.id)) d.drawn.push(next.id);
					paint();
					flip.classList.add('is-flipped');
					readBtn.hidden = false;
					drawBtn.textContent = 'Draw another';
				};
				if (flip.classList.contains('is-flipped') && !reduceMotion) {
					flip.classList.remove('is-flipped');
					setTimeout(apply, 260);
				} else apply();
			};
			paint();
			panel.onclick = (e) => {
				const b = e.target.closest('[data-dk]');
				if (!b) return;
				const act = b.dataset.dk;
				if (act === 'draw') draw();
				else if (act === 'read' && d.cur) window.openTeaser(d.cur, i.week);
				/* a face-down card draws, a face-up card opens its teaser */
				else if (act === 'flip') { if (d.cur && flip.classList.contains('is-flipped')) window.openTeaser(d.cur, i.week); else draw(); }
			};
		}

		/* ---- form 4: lenses ---- */
		function renderLenses(panel, i) {
			const list = i.topics;
			const paint = () => {
				const tiles = list.filter((t) => t.lens === i.lens);
				panel.innerHTML =
					'<div class="ls-chips">' +
					Object.entries(lenses).map(([k, v]) => '<button class="lens" data-ls="' + k + '" aria-pressed="' + (k === i.lens) + '">' + v.label + '</button>').join('') +
					'<button class="lens lens--surprise" data-ls="surprise">Surprise me</button></div>' +
					'<p class="ls-intro">' + lenses[i.lens].intro + '</p>' +
					(tiles.length
						? '<div class="tiles">' + tiles.map((t) =>
								'<button class="tile" data-topic="' + t.id + '" data-week="' + i.week + '"><span class="t-title">' + esc(t.title) + '</span><span class="t-hook">' + md(t.hook) + '</span></button>'
						  ).join('') + '</div>'
						: '<p class="tx-empty">Nothing under this lens in week ' + weekNum(i.week) + '. Try another lens or another week.</p>');
			};
			paint();
			panel.onclick = (e) => {
				const b = e.target.closest('[data-ls]');
				if (!b) return;
				if (b.dataset.ls === 'surprise') {
					window.openTeaser(rnd(list).id, i.week);
					return;
				}
				i.lens = b.dataset.ls;
				paint();
			};
		}

		/* start once every helper above exists */
		resetWeekState(inst);
		render(inst);
	})();
</script>

