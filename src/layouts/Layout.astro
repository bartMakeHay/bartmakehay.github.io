---
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>{title}</title>
	</head>
	<body class="min-h-screen flex flex-col bg-paper text-ink font-sans antialiased">
		<header class="mx-auto w-full max-w-2xl border-b border-border px-4 py-6">
			<a href="/" class="text-lg font-bold text-ink hover:text-accent">bartmakehay</a>
		</header>
		<div class="flex-1">
			<slot />
		</div>
		<footer class="mx-auto w-full max-w-2xl border-t border-border px-4 py-6 text-sm text-muted">
			<p>
				Written by <a href="https://www.linkedin.com/in/duboisbart/" class="text-accent hover:text-accent-hover">Bart Du Bois</a>, founder of <a href="https://www.makehay.be" class="text-accent hover:text-accent-hover">Make Hay BV</a>.
			</p>
		</footer>
	</body>
</html>
